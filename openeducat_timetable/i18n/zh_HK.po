"                                                            </li>\n"
"                                                            <li>\n"
"                                                                Course:\n"
"                                                                <span>\n"
"                                                                    <t t-out=\"object.course_id.name\"/>\n"
"                                                                </span>\n"
"                                                            </li>\n"
"                                                            <li>\n"
"                                                                Batch:\n"
"                                                                <span>\n"
"                                                                    <t t-out=\"object.batch_id.name\"/>\n"
"                                                                </span>\n"
"                                                            </li>\n"
"                                                            <li>\n"
"                                                                Classroom:\n"
"                                                                <span>\n"
"                                                                    <t t-out=\"object.classroom_id.name\"/>\n"
"                                                                </span>\n"
"                                                            </li>\n"
"                                                            <li>\n"
"                                                                Start Time:\n"
"                                                                <span>\n"
