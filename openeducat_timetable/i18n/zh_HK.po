"                                                                    <t t-out=\"format_datetime(object.start_datetime, tz=zone)\"/>\n"
"                                                                </span>\n"
"                                                            </li>\n"
"                                                            <li>\n"
"                                                                End Time:\n"
"                                                                <span>\n"
