"                                                        <br/>\n"
"                                                    </td>\n"
"                                                    <td valign=\"middle\" align=\"right\">\n"
"                                                        <img t-att-src=\"'/logo.png?company=%s' % object.company_id.id\" style=\"padding: 0px; margin: 0px; height: auto; width: 80px;\" t-att-alt=\"'%s' % object.company_id.name\"/>\n"
