<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <template id="report_marksheet_report">
            <t t-call="web.html_container">
                <t t-foreach="get_objects(docs)" t-as="objs">
                    <t t-foreach="objs" t-as="obj">
                        <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            <div class="text-center mt-4 mb-4">
                                <h2 class="mt-2 mb-2">
                                    <strong>MarkSheet</strong>
                                </h2>
                            </div>
                                <t t-if="obj.evaluation_type == 'normal'">
                                    <div id="informations" class="row mt-4 mb-4">
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong>Student Name</strong>
                                            <p class="m-0" t-out="obj.student_id.name or ''"/>
                                        </div>
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong>Course</strong>
                                            <p class="m-0" t-out="obj.marksheet_reg_id.exam_session_id.course_id.name or ''"/>
                                        </div>
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong>Exam Name</strong>
                                            <p class="m-0" t-out="obj.marksheet_reg_id.name or ''"/>
                                        </div>
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong>Exam Code</strong>
                                            <p class="m-0" t-out="obj.marksheet_reg_id.exam_session_id.exam_code or ''"/>
                                        </div>
                                    </div>
                                    <table class="table table-sm o_main_table table-borderless mt-4 mb-0" name="marks_table">
                                        <thead>
                                            <tr>
                                                <th class="text-center align-middle">Subject</th>
                                                <th class="text-center align-middle">Exam Type</th>
                                                <th class="text-center align-middle">Total Marks</th>
                                                <th class="text-center align-middle">Passing Marks</th>
                                                <th class="text-center align-middle">Obtained Marks</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="get_lines(obj)" t-as="lines">
                                                <t t-foreach="lines" t-as="result">
                                                    <tr>
                                                        <td class="text-start">
                                                            <span t-out="result.exam_id.subject_id.name or ''"/>
                                                        </td>
                                                        <td class="text-center">
                                                            <span t-out="result.exam_id.session_id.exam_type.name or ''"/>
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <span t-out="result.exam_id.total_marks or ''"/>
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <span t-out="result.exam_id.min_marks or ''"/>
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <span t-out="result.marks if result.marks else '--'"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                    <table class="table table-sm o_main_table table-borderless mt-4">
                                        <thead>
                                            <tr>
                                                <th class="text-center align-middle">Month/Year of Passing</th>
                                                <th class="text-center align-middle">Obtained Marks / Total Marks</th>
                                                <th class="text-center align-middle">Percentage</th>
                                                <th class="text-center align-middle">Result</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="text-center align-middle">
                                                    <span t-out="get_date(obj.generated_date) or ''"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-out="obj.total_marks or ''"/> / <span t-out="get_total(get_lines(obj)) or ''"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-out="obj.percentage or ''"/> %
                                                </td>
                                                <td class="text-center align-middle text-capitalize fw-bold">
                                                    <span t-out="obj.status or ''"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-if="obj.evaluation_type == 'grade'">
                                    <div id="informations" class="row mt-4 mb-4">
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong>Student Name</strong>
                                            <p class="m-0" t-out="obj.student_id.name or ''"/>
                                        </div>
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong>Course</strong>
                                            <p class="m-0" t-out="obj.marksheet_reg_id.exam_session_id.course_id.name or ''"/>
                                        </div>
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong>Exam Name</strong>
                                            <p class="m-0" t-out="obj.marksheet_reg_id.name or ''"/>
                                        </div>
                                        <div class="col-auto col-3 mw-100 mb-2">
                                            <strong>Exam Code</strong>
                                            <p class="m-0" t-out="obj.marksheet_reg_id.exam_session_id.exam_code or ''"/>
                                        </div>
                                    </div>
                                    <table class="table table-sm o_main_table table-borderless mt-4 mb-0" name="grades_table">
                                        <thead>
                                            <tr>
                                                <th class="text-center align-middle">Subject</th>
                                                <th class="text-center align-middle">Exam Type</th>
                                                <th class="text-center align-middle">Grade</th>
                                                <th class="text-center align-middle">Absent</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="get_lines(obj)" t-as="lines">
                                                <t t-foreach="lines" t-as="result">
                                                    <tr>
                                                        <td class="text-start">
                                                            <span t-out="result.exam_id.subject_id.name or ''"/>
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <span t-out="result.exam_id.session_id.exam_type.name or ''"/>
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <span t-out="result.grade if result.grade else '--'"/>
                                                        </td>
                                                        <td class="text-center align-middle">
                                                            <span t-out="'P' if result.marks > 0 else 'A'"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                    <table class="table table-sm o_main_table table-borderless mt-4">
                                        <thead>
                                            <tr>
                                                <th class="text-center align-middle">Month/Year of Passing</th>
                                                <th class="text-center align-middle">Obtained Grade</th>
                                                <th class="text-center align-middle">Result</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="text-center align-middle">
                                                    <span t-out="get_date(obj.generated_date) or ''"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-out="obj.grade or ''"/>
                                                </td>
                                                <td class="text-center align-middle text-capitalize fw-bold">
                                                    <span t-out="obj.status or ''"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </template>

</odoo>
