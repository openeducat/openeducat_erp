<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="soome_database_selector" inherit_id="web.database_selector">
        <xpath expr="//div[hasclass('o_database_list')]" position="before">
            <div style="text-align: center; margin-bottom: 30px;">
                <img src="/soome_branding/static/src/img/soome_logo.svg" 
                     style="width: 280px; margin-bottom: 10px;"/>
                <p style="color: #38BD78; font-size: 13px; letter-spacing: 3px; margin: 0;">
                    PLATEFORME SCOLAIRE NUMÉRIQUE
                </p>
            </div>
        </xpath>
    </template>
</odoo>
