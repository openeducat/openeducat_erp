<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="soome_login_layout" inherit_id="web.login_layout">
        <xpath expr="//img[@alt='Logo']" position="replace">
            <img src="/soome_branding/static/src/img/soome_logo.svg" 
                 alt="SOOME" 
                 style="max-height:120px; max-width:100%; width:auto"/>
        </xpath>
    </template>
</odoo>
