<odoo>

        <template id="report_media_barcode">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <t t-set="layout_document_title">
                            <span>Media: <t t-esc="o.name"/></span>
                        </t>
                        <div class="page">
                            <div class="oe_structure" id="report_media_barcode_structure"/>
                            <table class="table table-sm o_main_table table-borderless mt-4">
                                <thead>
                                    <tr>
                                        <th class="text-center align-middle">Media Unit</th>
                                        <th class="text-center align-middle">Barcode</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="text-center" t-foreach="o.unit_ids" t-as="unit">
                                        <td class="align-middle small">
                                            <span t-if="unit.name" t-field="unit.name"/>
                                        </td>
                                        <td class="align-middle py-3">
                                            <img class="img-fluid" t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', unit.barcode, 300, 40)" alt="Barcode"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

</odoo>
