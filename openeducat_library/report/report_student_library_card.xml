<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <template id="report_student_library_card">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page mt-4 border border-dark border-2 p-3 mb-4" style="width: 440px; min-height: 260px;">
                            <div class="d-flex align-items-center mb-2">
                                <img class="image me-3" t-att-src="image_data_uri(res_company.logo)" style="max-height: 60px; max-width: 100px;"/>
                                <div>
                                    <h2 class="mb-0 mt-0 fs-4 text-nowrap">Library Card</h2>
                                    <span class="text-muted fw-bold small text-nowrap" t-out="res_company.partner_id.name if res_company.partner_id.name else ''"/>
                                </div>
                            </div>
                            <hr class="w-100 mt-2 mb-3"/>
                            <div class="row m-0">
                                <div class="col-4 p-0">
                                    <img class="img-thumbnail w-100 p-0" t-att-src="image_data_uri(o.image_1920)" style="max-height: 130px; object-fit: contain;"/>
                                </div>
                                <div class="col-8 ps-3 pe-0">
                                    <p class="mb-1 small">
                                        <strong>Name:</strong>
                                        <span t-field="o.name"/>
                                    </p>
                                    <p class="mb-1 small" t-if="o.library_card_id">
                                        <strong>Card No:</strong>
                                        <span t-field="o.library_card_id.number"/>
                                    </p>
                                    <p class="mb-1 small" t-if="o.library_card_id">
                                        <strong>Type:</strong>
                                        <span t-field="o.library_card_id.library_card_type_id.name"/>
                                    </p>
                                    <p class="mb-1 small" t-if="o.library_card_id">
                                        <strong>Issued Date:</strong>
                                        <span t-field="o.library_card_id.issue_date" t-options="{'widget':'date'}"/>
                                    </p>
                                    <div class="mt-2" t-if="o.library_card_id and o.library_card_id.number">
                                        <img class="img-fluid" t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.library_card_id.number, 180, 30)" alt="Barcode"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

</odoo>
