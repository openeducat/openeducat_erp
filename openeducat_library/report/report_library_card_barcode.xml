<odoo>

        <template id="report_library_card_barcode">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-set="layout_document_title">
                        Library Card(s) Barcode
                    </t>
                    <div class="page">
                        <div class="oe_structure" id="report_library_card_barcode_structure"/>
                        
                        <table class="table table-sm o_main_table table-borderless mt-4">
                            <thead>
                                <tr>
                                    <th class="text-center align-middle">Card Holder</th>
                                    <th class="text-center align-middle">Card Barcode</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="card">
                                    <tr class="text-center">
                                        <td class="align-middle w-50">
                                            <h4>
                                                <span t-field="card.student_id.name"/>
                                            </h4>
                                        </td>
                                        <td class="align-middle py-3 w-50">
                                            <img class="img-fluid" t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', card.number, 350, 60)" alt="Barcode"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>

</odoo>
