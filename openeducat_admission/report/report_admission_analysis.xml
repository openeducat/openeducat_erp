<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <template id="report_admission_analysis">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-set="layout_document_title">
                        Admission Analysis
                    </t>
                    <div class="page">
                        <div class="oe_structure"/>
                        <div id="informations" class="row mt-5 pt-3 mb-4">
                            <div class="col-auto col-3" t-if="data.get('course_id') and data['course_id'][1]" name="course">
                                <strong>COURSE</strong>
                                <p class="m-0" t-out="data['course_id'][1]"/>
                            </div>
                            <div class="col-auto col-3" t-if="data.get('start_date')" name="start_date">
                                <strong>FROM DATE</strong>
                                <p class="m-0" t-esc="data['start_date']" t-options="{'widget': 'date'}"/>
                            </div>
                            <div class="col-auto col-3" t-if="data.get('end_date')" name="end_date">
                                <strong>TO DATE</strong>
                                <p class="m-0" t-esc="data['end_date']" t-options="{'widget': 'date'}"/>
                            </div>
                        </div>
                        <table class="table o_main_table table-borderless mt-2" style="font-size:14px;">
                            <thead>
                                <tr>
                                    <th class="text-start">STUDENT NAME</th>
                                    <th class="text-start">APPLICATION NO.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="get_data" t-as="record">
                                    <tr>
                                        <td class="text-start">
                                            <span t-esc="record['name']"/>
                                        </td>
                                        <td class="text-start">
                                            <span t-out="record['application_no'] if record.get('application_no') else ''"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div id="total" class="row justify-content-start mt-2">
                            <div class="col-4">
                                <table class="o_total_table table table-borderless">
                                    <tr class="o_total">
                                        <td><strong>TOTAL STUDENTS</strong></td>
                                        <td class="text-end">
                                            <strong><span t-esc="get_total_student"/></strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
</odoo>
